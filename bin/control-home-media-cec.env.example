# Version: 12

# Paths are rewritten by control-home-media-cec.install when it creates:
#   ~/.config/control-home-media/media-cec.env
CONTROL_HOME_MEDIA_REPO=/home/deck/.local/share/control-home-media

# Safe CEC state checks for the remote-button listener.
MEDIA_CEC_STATUS_COMMAND=/usr/bin/cec-ctl -d /dev/cec0 --playback -S
MEDIA_CEC_SAFE_INIT_COMMAND=/usr/bin/cec-ctl -d /dev/cec0 --playback -S
MEDIA_CEC_CHECK_INTERVAL_SECONDS=5
MEDIA_CEC_INPUT_NAME_PATTERN=^(DP-4|cecd)
MEDIA_CEC_INPUT_GRAB=1
MEDIA_CEC_KEY_OK_CODE=28
MEDIA_CEC_KEY_BACK_CODE=1
MEDIA_CEC_WATCHDOG_ENABLED=1
MEDIA_CEC_WATCHDOG_FD_THRESHOLD=900
MEDIA_CEC_WATCHDOG_INPUT_MISSING_GRACE_SECONDS=120
# Deprecated legacy variable. Unsafe wake/source commands are ignored by the listener.
# MEDIA_CEC_REFRESH_COMMAND=

# Color buttons.
MEDIA_CEC_KEY_RED_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home
MEDIA_CEC_KEY_GREEN_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+x
# MEDIA_CEC_KEY_YELLOW_COMMAND=
MEDIA_CEC_KEY_BLUE_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+a

# Number buttons as gamepad buttons.
MEDIA_CEC_KEY_1_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py lb
MEDIA_CEC_KEY_2_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py y
MEDIA_CEC_KEY_3_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py rb
MEDIA_CEC_KEY_4_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py x
MEDIA_CEC_KEY_5_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py a
MEDIA_CEC_KEY_6_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py b
MEDIA_CEC_KEY_7_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py lt
MEDIA_CEC_KEY_8_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py start
MEDIA_CEC_KEY_9_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py rt
