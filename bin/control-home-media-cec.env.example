# Version: 4

# Paths are rewritten by control-home-media-cec.install when it creates:
#   ~/.config/control-home-media/media-cec.env
CONTROL_HOME_MEDIA_REPO=/home/deck/.local/share/control-home-media

# Safe CEC state checks for the color-button listener.
MEDIA_CEC_STATUS_COMMAND=/usr/bin/cec-ctl -d /dev/cec0 --playback -S
MEDIA_CEC_SAFE_INIT_COMMAND=/usr/bin/cec-ctl -d /dev/cec0 --playback -S
MEDIA_CEC_CHECK_INTERVAL_SECONDS=5
# Deprecated legacy variable. Unsafe wake/source commands are ignored by the listener.
# MEDIA_CEC_REFRESH_COMMAND=

# Color buttons.
MEDIA_CEC_KEY_RED_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home
MEDIA_CEC_KEY_GREEN_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+a
MEDIA_CEC_KEY_YELLOW_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+x
# MEDIA_CEC_KEY_BLUE_COMMAND=
