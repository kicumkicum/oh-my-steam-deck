# Version: 1

# Paths are rewritten by control-home-media-cec.install when it creates:
#   ~/.config/control-home-media/media-cec.env
CONTROL_HOME_MEDIA_REPO=/home/deck/p/control-home-media
CONTROL_MEDIA=/home/deck/p/control-home-media/control_media.py
CONTROL_MEDIA_CONFIG=/home/deck/p/control-home-media/control_media.config.json

# Set this if php is not visible in the systemd user service PATH.
# CONTROL_MEDIA_PHP=/usr/bin/php

MEDIA_RECEIVER_ID=192.168.1.112
MEDIA_RECEIVER_VOLUME_STEP=1

# Refresh CEC before listening so the TV starts forwarding remote key events.
MEDIA_CEC_REFRESH_COMMAND=distrobox enter media-cec -- cec-ctl -d /dev/cec0 --playback --to 0 --image-view-on --to 0 --active-source phys-addr=1.0.0.0

# Color buttons.
MEDIA_CEC_KEY_RED_COMMAND=env DISPLAY=:0 xdotool key shift+Tab
MEDIA_CEC_KEY_GREEN_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+a
MEDIA_CEC_KEY_YELLOW_COMMAND=/home/deck/bin/steam-gamepad-shortcut.py home+x
# MEDIA_CEC_KEY_BLUE_COMMAND=
