# Version: 2

[Unit]
Description=Control Home Media CEC color button listener
Documentation=https://github.com/
Wants=control-home-media-steam-gamepad.service
After=control-home-media-steam-gamepad.service

[Service]
Type=simple
EnvironmentFile=%h/.config/control-home-media/media-cec.env
ExecStart=/usr/bin/env python3 %h/bin/cec-input-color-buttons.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
