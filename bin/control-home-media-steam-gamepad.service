# Version: 2

[Unit]
Description=Control Home Media Steam virtual gamepad shortcut daemon
Documentation=https://github.com/

[Service]
Type=simple
Environment=STEAM_GAMEPAD_SHORTCUT_PROFILE=8bitdo-ultimate-2c
ExecStart=/usr/bin/env python3 %h/bin/steam-gamepad-shortcut.py --daemon --settle 3 --name "IR Remote Gamepad"
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
