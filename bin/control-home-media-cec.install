#!/bin/bash
# Version: 5
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
BUNDLE_DIR="$SCRIPT_DIR/control-home-media"
APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/control-home-media"

find_control_home_media_repo() {
    local candidate

    if [ -n "${CONTROL_HOME_MEDIA_REPO:-}" ]; then
        printf '%s\n' "$CONTROL_HOME_MEDIA_REPO"
        return 0
    fi

    for candidate in \
        "$BUNDLE_DIR" \
        "$REPO_DIR"
    do
        if [ -f "$candidate/scripts/steam-gamepad-shortcut.py" ] &&
            [ -f "$candidate/scripts/cec-input-color-buttons.py" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

BIN_DIR="$HOME/bin"
USER_UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/control-home-media"
ENV_FILE="$CONFIG_DIR/media-cec.env"
SOURCE_REPO="$(find_control_home_media_repo || true)"

STEAM_GAMEPAD_UNIT="control-home-media-steam-gamepad.service"
CEC_BUTTONS_UNIT="control-home-media-cec-buttons.service"

echo "Installing Control Home Media CEC services from $REPO_DIR"

if [ -z "$SOURCE_REPO" ]; then
    cat >&2 <<EOF
Could not find bundled control-home-media CEC color button runtime scripts.

Run this installer from oh-my-steam-deck, or pass:
  CONTROL_HOME_MEDIA_REPO=/path/to/runtime $0
EOF
    exit 1
fi

echo "Using Control Home Media CEC color button runtime from $SOURCE_REPO"

mkdir -p "$BIN_DIR" "$USER_UNIT_DIR" "$CONFIG_DIR" "$APP_DIR"

rm -f "$APP_DIR/control_media.py" "$APP_DIR/control_media.config.example.json"
rm -rf "$APP_DIR/harman-kardon-remote"
mkdir -p "$APP_DIR/scripts"
install -m 0755 "$SOURCE_REPO/scripts/steam-gamepad-shortcut.py" "$APP_DIR/scripts/steam-gamepad-shortcut.py"
install -m 0755 "$SOURCE_REPO/scripts/cec-input-color-buttons.py" "$APP_DIR/scripts/cec-input-color-buttons.py"
rm -f "$APP_DIR/scripts/cec-input-receiver-volume.py" "$APP_DIR/scripts/steamos-wakeup-media-cec.sh"

install -m 0755 "$APP_DIR/scripts/steam-gamepad-shortcut.py" "$BIN_DIR/steam-gamepad-shortcut.py"
install -m 0755 "$APP_DIR/scripts/cec-input-color-buttons.py" "$BIN_DIR/cec-input-color-buttons.py"
rm -f "$BIN_DIR/cec-input-receiver-volume.py" "$BIN_DIR/steamos-wakeup-media-cec.sh"

install -m 0644 "$SCRIPT_DIR/$STEAM_GAMEPAD_UNIT" "$USER_UNIT_DIR/$STEAM_GAMEPAD_UNIT"
install -m 0644 "$SCRIPT_DIR/$CEC_BUTTONS_UNIT" "$USER_UNIT_DIR/$CEC_BUTTONS_UNIT"

if [ ! -f "$ENV_FILE" ]; then
    cat > "$ENV_FILE" <<EOF
# Version: 2
CONTROL_HOME_MEDIA_REPO=$APP_DIR
MEDIA_CEC_REFRESH_COMMAND=distrobox enter media-cec -- cec-ctl -d /dev/cec0 --playback --to 0 --image-view-on --to 0 --active-source phys-addr=1.0.0.0
MEDIA_CEC_KEY_RED_COMMAND=$BIN_DIR/steam-gamepad-shortcut.py home
MEDIA_CEC_KEY_GREEN_COMMAND=$BIN_DIR/steam-gamepad-shortcut.py home+a
MEDIA_CEC_KEY_YELLOW_COMMAND=$BIN_DIR/steam-gamepad-shortcut.py home+x
# MEDIA_CEC_KEY_BLUE_COMMAND=
EOF
    echo "Created $ENV_FILE"
else
    echo "Keeping existing $ENV_FILE"
    echo "Reference config: $SCRIPT_DIR/control-home-media-cec.env.example"
fi

systemctl --user daemon-reload
systemctl --user enable --now "$STEAM_GAMEPAD_UNIT"
systemctl --user enable --now "$CEC_BUTTONS_UNIT"

cat <<EOF
COMPLETE

Useful commands:
  systemctl --user status --no-pager -l $STEAM_GAMEPAD_UNIT
  systemctl --user status --no-pager -l $CEC_BUTTONS_UNIT
  journalctl --user -u $CEC_BUTTONS_UNIT -f

To change button bindings, edit:
  $ENV_FILE

Then apply:
  systemctl --user restart $CEC_BUTTONS_UNIT
EOF
